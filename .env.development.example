# ==============================================================================
# GOSEDMA — LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env.local` for local development on your machine.
#
# MODE A: DEMO / MOCK DATABASE MODE (Zero Setup Required)
# Leave NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY empty.
# The app will automatically run using its built-in local Mock Database.
# You can log into admin with: admin@gosedma.com / demo123
#
# MODE B: CONNECT TO REAL SUPABASE (Live Database Testing)
# Paste your Supabase project keys below.
# ==============================================================================

# ─── Supabase (Leave empty for Mock Mode, or fill for live DB) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key (optional for local dev)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security / Bot Protection (Optional for local testing) ────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Email Notifications (Optional for local testing) ──────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@gosedma.com
ADMIN_NOTIFICATION_EMAIL=admin@gosedma.com

# ─── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
