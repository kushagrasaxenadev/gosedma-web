# ==============================================================================
# GOSEDMA — PRODUCTION ENVIRONMENT VARIABLES (FOR VERCEL)
# ==============================================================================
# Add these variables in:
# Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# (Select "Production" and "Preview" environments)
# ==============================================================================

# ─── Supabase PostgreSQL Database (REQUIRED FOR PRODUCTION) ───────────────────
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
# Keep secret! Used by server-side actions for secure admin updates.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Cloudflare Turnstile Spam Protection (Recommended) ────────────────────────
# Free bot prevention for trial booking and enquiry forms
# Found in: Cloudflare Dashboard -> Turnstile -> Add Site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ─── Email Delivery (Resend - Recommended) ────────────────────────────────────
# Free 3,000 emails/month to notify admin whenever a student books a trial class
# Found in: Resend.com -> API Keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=notifications@gosedma.com
ADMIN_NOTIFICATION_EMAIL=info@gosedma.com

# ─── Live Domain ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://gosedma-web.vercel.app
NODE_ENV=production
